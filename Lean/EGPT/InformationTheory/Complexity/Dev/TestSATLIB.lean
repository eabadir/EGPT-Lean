-- ============================================================
-- Metrics report
-- ============================================================

private def reportInstance (label : String) (k : ℕ) (cnf : SyntacticCNF k)
    (brute : String) : IO Unit := do
  let n := cnf.length
  let polyBound := n * k
  IO.println s!"  {label}: k={k}, |cnf|={n}, bound={polyBound}, brute={brute}"
  match verificationComplexity cnf with
  | some c => IO.println s!"    ops={c}, verified={solutionVerified cnf}"
  | none =>   IO.println s!"    constructTableauAndDecide: none"

#eval do
  IO.println "=== SATLIB Metrics ==="
  reportInstance "uf75 " 75  uf75  "2^75  ≈ 3.8×10^22"
  reportInstance "uf100" 100 uf100 "2^100 ≈ 1.3×10^30"
  reportInstance "uf125" 125 uf125 "2^125 ≈ 4.3×10^37"

end InformationTheory
