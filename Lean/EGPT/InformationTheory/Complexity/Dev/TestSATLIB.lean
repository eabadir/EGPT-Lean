-- Constructive path: CNF only, no pre-supplied assignment
-- ============================================================

section UF75
-- 75 variables, 325 clauses — 2^75 ≈ 3.8 × 10^22
example : hasExtractableAtoms uf75 = true := by native_decide
-- constructTableauAndDecide returns none on this random phase-transition instance
example : (constructTableauAndDecide uf75).isSome = false := by native_decide
end UF75

